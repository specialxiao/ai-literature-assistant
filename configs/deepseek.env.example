# Obtain the key from the official DeepSeek platform. Never commit a real key.
TECHLIT_LLM_API_KEY=
TECHLIT_LLM_BASE_URL=https://api.deepseek.com
TECHLIT_LLM_MODEL=deepseek-flash
TECHLIT_LLM_API_MODE=responses

# DeepSeek's public API docs do not currently list an embeddings endpoint.
# Use the local bilingual E5 encoder, independent of the answer API.
TECHLIT_EMBEDDING_PROVIDER=local
TECHLIT_LOCAL_MODEL_PATH=data/models/multilingual-e5-small
TECHLIT_LOCAL_MIN_SCORE=0
TECHLIT_EMBEDDING_API_KEY=
TECHLIT_EMBEDDING_BASE_URL=
TECHLIT_EMBEDDING_MODEL=
TECHLIT_EMBEDDING_DIMENSIONS=

TECHLIT_DB_PATH=data/app.db
