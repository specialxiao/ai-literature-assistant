# Answer generation. Most third-party compatible services use chat_completions.
# Base URLs normally include /v1; copy the exact value from your provider's docs.
TECHLIT_LLM_API_KEY=
TECHLIT_LLM_BASE_URL=
TECHLIT_LLM_MODEL=
TECHLIT_LLM_API_MODE=chat_completions

# Semantic retrieval. It may use a different provider from the answer model.
# Local encoders need no embedding API key. Install .[local] and download the model first.
TECHLIT_EMBEDDING_PROVIDER=local
TECHLIT_LOCAL_MODEL=minilm
TECHLIT_LOCAL_MODEL_PATH=data/models/paraphrase-multilingual-MiniLM-L12-v2
# Scores are not probabilities. 0.35 is selected on the synthetic development split.
TECHLIT_LOCAL_MIN_SCORE=0.35
# Leave DIMENSIONS empty when the provider does not document this parameter.
TECHLIT_EMBEDDING_API_KEY=
TECHLIT_EMBEDDING_BASE_URL=
TECHLIT_EMBEDDING_MODEL=
TECHLIT_EMBEDDING_DIMENSIONS=

# Relative paths are resolved from the repository root.
TECHLIT_DB_PATH=data/app.db

